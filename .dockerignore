.git
.env
.env.*
!.env.example
# Anchored to the context root so it can never filter the global
# /usr/local/lib/node_modules tree copied out of the build stage.
/node_modules
npm-debug.log*
*.log
README.md
# The image build needs these helpers; keep the remaining local test and
# release helpers out of the Docker context.
scripts/*
!scripts/instrument-qqbot-startup.mjs
!scripts/link-global-bins.mjs
!scripts/enforce-chat-only.mjs
!scripts/enforce-web-search.mjs
!scripts/enforce-model-context.mjs
.workbuddy/
/third_party
