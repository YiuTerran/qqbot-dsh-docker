# Only required for dsh's default deepseek-official route.
DEEPSEEK_API_KEY=
# Use for a custom dsh provider whose apiKeyEnv is LLM_API_KEY.
LLM_API_KEY=
# Set the next four values with LLM_API_KEY to configure an OpenAI-compatible
# route. LLM_API_PROTOCOL is optional; the container defaults it to
# openai-responses.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_BASE_URL=
LLM_API_PROTOCOL=
QQBOT_APPID=
QQBOT_SECRET=
# Optional startup-warning threshold in milliseconds; defaults to 20000.
QQBOT_STARTUP_WARN_MS=20000
# Optional override only when vision should use a different route from LLM_*.
# Empty values reuse LLM_PROVIDER / LLM_MODEL, then fall back to
# deepseek-official / deepseek-flash.
QQBOT_VISION_PROVIDER=
QQBOT_VISION_MODEL=
# Keep the bot unable to modify files by default. Set workspace-write only for
# deployments that deliberately need changes under /workspace.
DSH_PERMISSION_MODE=read-only
IMAGE_TAG=v0.1.0
