# Choose exactly one chat credential mode. This key selects the official route.
DEEPSEEK_API_KEY=
# Third-party mode: configure all LLM_* route values with this key.
LLM_API_KEY=
# Set the next four values with LLM_API_KEY to configure an OpenAI-compatible
# route. LLM_API_PROTOCOL is optional; the container defaults it to
# openai-responses.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_BASE_URL=
LLM_API_PROTOCOL=
# Optional native DeepSeek search endpoint, independent of the chat endpoint.
# Leave blank to disable web_search in LLM_API_KEY mode. It uses LLM_API_KEY.
LLM_SEARCH_BASE_URL=
# Optional native search model alias in either key mode; blank defaults to deepseek-flash.
LLM_SEARCH_MODEL=
QQBOT_APPID=
QQBOT_SECRET=
# Leave both enabled by default. Set one to false for a startup isolation test.
QQBOT_MEDIA_ENABLED=true
QQBOT_VISION_ENABLED=true
# Group messages use only the current batch by default; false restores SDK history.
QQBOT_GROUP_CURRENT_ONLY=true
# Temporary, redacted quote/download/edit-grant diagnostics in container logs.
QQBOT_IMAGE_DEBUG=false
# Temporary, redacted QQ inbound and actual model-input context diagnostics.
QQBOT_CONTEXT_DEBUG=false
# Optional startup-warning threshold in milliseconds; defaults to 20000.
QQBOT_STARTUP_WARN_MS=20000
# Vision provider must match the active credential mode when a key is set.
# QQBOT_VISION_MODEL may override the mode's default model.
QQBOT_VISION_PROVIDER=
QQBOT_VISION_MODEL=
# Optional independent image-generation route. Leave all four values blank to
# hide image generation; when enabled, set key/base URL/model together.
# IMAGE_API_PROTOCOL is openai-images by default and also supports xai-images.
IMAGE_API_KEY=
IMAGE_API_BASE_URL=
IMAGE_MODEL=
IMAGE_API_PROTOCOL=
# Markdown creation is enabled by default; set false to disable it.
QQBOT_MARKDOWN_ENABLED=true
# Rolling-hour per-user limits and process-wide active-task slots.
QQBOT_IMAGE_USER_HOURLY_LIMIT=10
QQBOT_MARKDOWN_USER_HOURLY_LIMIT=30
QQBOT_IMAGE_MAX_CONCURRENT=2
QQBOT_MARKDOWN_MAX_CONCURRENT=4
# Shell, code execution, file downloads, and general file tools are disabled in
# both private and group chat; public HTML webpages remain readable. Only the
# dedicated image and Markdown tools are permitted exceptions.
IMAGE_TAG=v0.1.0
